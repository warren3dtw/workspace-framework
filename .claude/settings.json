{
  "permissions": {
    "allow": [
      "mcp__rhino",
      "Bash(*cadcraft-cli* *)",
      "PowerShell(*cadcraft-cli* *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__rhino__.*|mcp__plugin_.*rhino__.*|mcp__cadcraft__.*|mcp__plugin_.*cadcraft__.*|Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v py >/dev/null 2>&1; then py -3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/agent_guard.py\"; else python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/agent_guard.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__rhino__run_(python|csharp)|mcp__plugin_.*rhino__run_(python|csharp)",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v py >/dev/null 2>&1; then py -3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/agent_guard.py\"; else python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/agent_guard.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "MCP_TOOL_TIMEOUT": "300000",
    "PYTHONUTF8": "1"
  }
}
